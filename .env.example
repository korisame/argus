# argus configuration — copy to ~/.argus/.env (or ~/Developer/argus/.env)
# and fill in your values. Never commit the real .env.

# REQUIRED — Moondream cloud API key for the visual grounding fallback.
# Get one (free tier available) at: https://moondream.ai/c/cloud
# Without this, the AX → OCR cascade still works for native apps with text labels,
# but semantic targets like "the gear icon top right" will fail.
MOONDREAM_API_KEY=

# OPTIONAL — Vision model variant. Default: moondream2.
# ARGUS_VISION_MODEL=moondream2

# OPTIONAL — Free Moondream RAM after every vision call. Default: 1.
# Set to 0 for burst workloads (faster, more RAM).
# ARGUS_VISION_AUTO_UNLOAD=1
